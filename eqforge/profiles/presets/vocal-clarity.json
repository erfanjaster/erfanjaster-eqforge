{
  "format": "eqforge.profile",
  "format_version": 2,
  "id": "vocal-clarity",
  "name": "Vocal Clarity",
  "description": "Brings voices forward: removes low rumble, opens the presence region, tames harshness around 3 kHz.",
  "tags": [
    "vocals",
    "clarity"
  ],
  "builtin": true,
  "preamp": {
    "mode": "auto"
  },
  "eq": {
    "filters": [
      {
        "type": "highpass",
        "freq": 85,
        "gain_db": 0.0,
        "q": 0.707,
        "enabled": true,
        "name": "rumble guard"
      },
      {
        "type": "peak",
        "freq": 320,
        "gain_db": -1.5,
        "q": 1.1,
        "enabled": true,
        "name": "de-box"
      },
      {
        "type": "peak",
        "freq": 2800,
        "gain_db": 2.5,
        "q": 1.4,
        "enabled": true,
        "name": "presence"
      },
      {
        "type": "peak",
        "freq": 6500,
        "gain_db": 1.0,
        "q": 1.6,
        "enabled": true,
        "name": "air"
      }
    ]
  },
  "limiter": {
    "enabled": true,
    "ceiling_db": -1.0,
    "attack_ms": 5.0,
    "release_ms": 60.0,
    "lookahead_ms": 1.5,
    "knee_db": 3.0
  }
}
