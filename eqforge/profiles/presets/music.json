{
  "format": "eqforge.profile",
  "format_version": 2,
  "id": "music",
  "name": "Music (Loudness Smile)",
  "description": "Gentle loudness-compensation curve for casual listening at moderate volume - lifted extremes, cleaned low-mids.",
  "tags": [
    "music",
    "casual"
  ],
  "builtin": true,
  "preamp": {
    "mode": "auto"
  },
  "eq": {
    "filters": [
      {
        "type": "lowshelf",
        "freq": 70,
        "gain_db": 3.0,
        "q": 0.71,
        "enabled": true,
        "use_q": false,
        "name": "bass"
      },
      {
        "type": "peak",
        "freq": 300,
        "gain_db": -1.5,
        "q": 0.9,
        "enabled": true,
        "name": "de-mud"
      },
      {
        "type": "highshelf",
        "freq": 9000,
        "gain_db": 2.0,
        "q": 0.71,
        "enabled": true,
        "use_q": false,
        "name": "sparkle"
      }
    ]
  },
  "limiter": {
    "enabled": true,
    "ceiling_db": -1.0,
    "attack_ms": 5.0,
    "release_ms": 60.0,
    "lookahead_ms": 1.5,
    "knee_db": 3.0
  }
}
