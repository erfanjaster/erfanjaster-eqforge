{
  "format": "eqforge.profile",
  "format_version": 2,
  "id": "headphone-crossfeed",
  "name": "Headphone + Crossfeed",
  "description": "Headphone base plus Bauer crossfeed for a more speaker-like, outside-the-head soundstage. Demonstrates profile inheritance.",
  "tags": [
    "headphone",
    "crossfeed",
    "binaural"
  ],
  "builtin": true,
  "preamp": {
    "mode": "auto"
  },
  "limiter": {
    "enabled": true,
    "ceiling_db": -1.0,
    "attack_ms": 5.0,
    "release_ms": 60.0,
    "lookahead_ms": 1.5,
    "knee_db": 3.0
  },
  "extends": [
    "headphone-base"
  ],
  "crossfeed": {
    "enabled": true,
    "level_db": -6.5,
    "fc_hz": 700.0
  },
  "eq": {
    "filters_op": "append"
  }
}
